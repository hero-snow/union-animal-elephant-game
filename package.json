{
    "name": "union-animal-elephant-game",
    "description": "動物合体ゲーム - Phaser 3, Matter.js, Vite & TypeScript による動物進化物理パズルゲーム",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hero-snow/union-animal-elephant-game.git"
    },
    "author": "Hiroyuki Oikawa",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hero-snow/union-animal-elephant-game/issues"
    },
    "homepage": "https://hero-snow.github.io/union-animal-elephant-game/",
    "scripts": {
        "dev": "node log.js dev & vite --config vite/config.dev.mjs",
        "build": "node log.js build & vite build --config vite/config.prod.mjs",
        "dev-nolog": "vite --config vite/config.dev.mjs",
        "build-nolog": "vite build --config vite/config.prod.mjs",
        "deploy": "npm run build-nolog && gh-pages -d dist"
    },
    "devDependencies": {
        "gh-pages": "^6.3.0",
        "playwright": "^1.62.0",
        "typescript": "^7.0.2",
        "vite": "^8.1.5"
    },
    "dependencies": {
        "phaser": "^4.2.1",
        "terser": "^5.49.0"
    }
}
